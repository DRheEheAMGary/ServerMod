{
	"schemaVersion": 1,
	"id": "hubsuite",
	"version": "${version}",
	"name": "HubSuite",
	"description": "多世界服务器套件：对话框注册/登录、假人大厅、生存/创造/空岛/海岛等完全独立的子服，并适配 HuskHomes 与 Placeholder API。玩家需同时安装配套的 hubsuite-client 客户端模组。",
	"authors": [
		"DreamGary"
	],
	"contact": {
		"homepage": "https://dreamgary.cn/",
		"sources": "https://dreamgary.cn/"
	},
	"license": "MIT",
	"icon": "assets/hubsuite/icon.png",
	"environment": "*",
	"accessWidener": "hubsuite.accesswidener",
	"entrypoints": {
		"main": [
			"cn.dreamgary.hubsuite.HubSuite"
		]
	},
	"mixins": [
		{
			"config": "hubsuite.mixins.json",
			"environment": "server"
		}
	],
	"depends": {
		"fabricloader": ">=${loaderVersion}",
		"minecraft": "${mcVersion}",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"huskhomes": "*",
		"placeholder-api": "*",
		"luckperms": "*",
		"jei": "*"
	}
}
